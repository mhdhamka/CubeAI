# CubeAI Docker Environment Configuration
# Copy this to .env.docker and customize as needed

# Database Configuration
DB_USER=cubeai
DB_PASSWORD=changeme123
DB_NAME=cube_ai_db

# API Service Configuration
SERVICE_NAME=CubeAI API
SERVICE_VERSION=0.1.0
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database URL (auto-constructed, but can be overridden)
# DATABASE_URL=postgresql://cubeai:changeme123@postgres:5432/cube_ai_db

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Frontend Configuration
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=cube-ai
