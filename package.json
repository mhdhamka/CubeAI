{
  "name": "cube-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "web:test": "vitest run tests/web-dashboard.test.tsx",
    "web:dev": "next dev apps/web",
    "web:e2e": "next dev apps/web --hostname 127.0.0.1 --port 3010",
    "web:build": "next build apps/web",
    "web:start": "next start apps/web",
    "api:dev": "python -m uvicorn apps.api.main:app --reload --host 0.0.0.0 --port 8000",
    "api:e2e": "python -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8010",
    "api:test": "python -m pytest apps/api/tests",
    "api:migrate": "python -m alembic upgrade head",
    "test:e2e": "playwright test",
    "api:install": "python -m pip install -r requirements.txt -r requirements-test.txt"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  }
}
