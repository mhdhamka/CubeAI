# Multi-stage build for Next.js
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace and configuration files
COPY package.json package-lock.json tsconfig.json ./

# Copy shared packages and the web app source
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Build arguments
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Install dependencies and build the web app directly
RUN npm ci && \
    npm run web:build

# Production runtime
FROM node:20-alpine AS runner

WORKDIR /app

# Copy package files and shared packages required at runtime
COPY package.json package-lock.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Install production dependencies only
RUN npm ci --production && \
    npm install -g pm2

# Copy built Next.js app from builder
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/public ./apps/web/public

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000 || exit 1

# Run Next.js
CMD ["npm", "run", "web:start"]