# CubeAI API Configuration
# Copy this file to .env and update values for your environment

# Service Configuration
SERVICE_NAME=CubeAI API
SERVICE_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Database
DATABASE_URL=postgresql://cube:cube@localhost:5432/cube_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# API Configuration
REQUEST_TIMEOUT=30
MAX_UPLOAD_SIZE=10485760

# Vision Service
VISION_CONFIDENCE_THRESHOLD=0.7
SCAN_MAX_RETRIES=3

# Solver
SOLVER_MAX_MOVES=20
SOLVER_TIMEOUT=10

# Coaching
COACHING_PROVIDER=deterministic
COACHING_EXTERNAL_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
